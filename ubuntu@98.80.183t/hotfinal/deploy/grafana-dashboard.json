{
  "title": "vcs-server",
  "schemaVersion": 39,
  "uid": "vcs-server",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [{"name": "ds", "type": "datasource", "query": "prometheus"}]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests/s by status", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": "${ds}", "targets": [{"expr": "sum by (status) (rate(vcs_server_requests_total[5m]))", "legendFormat": "{{status}}"}]},
    {"id": 2, "type": "timeseries", "title": "Latency p50 / p95 / p99", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": "${ds}", "targets": [
       {"expr": "histogram_quantile(0.5, sum by (le) (rate(vcs_server_request_duration_seconds_bucket[5m])))", "legendFormat": "p50"},
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(vcs_server_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"},
       {"expr": "histogram_quantile(0.99, sum by (le) (rate(vcs_server_request_duration_seconds_bucket[5m])))", "legendFormat": "p99"}]},
    {"id": 3, "type": "timeseries", "title": "Bytes/s in and out", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "datasource": "${ds}", "targets": [
       {"expr": "rate(vcs_server_request_bytes_total[5m])", "legendFormat": "in"},
       {"expr": "rate(vcs_server_response_bytes_total[5m])", "legendFormat": "out"}]},
    {"id": 4, "type": "timeseries", "title": "Rejections and conflicts /s", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "datasource": "${ds}", "targets": [
       {"expr": "rate(vcs_server_auth_failures_total[5m])", "legendFormat": "auth failures"},
       {"expr": "rate(vcs_server_rate_limited_total[5m])", "legendFormat": "rate limited"},
       {"expr": "rate(vcs_server_lock_conflicts_total[5m])", "legendFormat": "lock conflicts"},
       {"expr": "rate(vcs_server_audit_errors_total[5m])", "legendFormat": "audit errors"}]},
    {"id": 5, "type": "timeseries", "title": "Backend errors /s by kind", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
     "datasource": "${ds}", "targets": [{"expr": "sum by (kind) (rate(vcs_server_backend_errors_total[5m]))", "legendFormat": "{{kind}}"}]},
    {"id": 6, "type": "stat", "title": "Circuit open", "gridPos": {"x": 12, "y": 16, "w": 4, "h": 4},
     "datasource": "${ds}", "targets": [{"expr": "max(vcs_server_backend_circuit_open)"}]},
    {"id": 7, "type": "stat", "title": "Open connections", "gridPos": {"x": 16, "y": 16, "w": 4, "h": 4},
     "datasource": "${ds}", "targets": [{"expr": "sum(vcs_server_open_connections)"}]},
    {"id": 8, "type": "stat", "title": "Uptime (s)", "gridPos": {"x": 20, "y": 16, "w": 4, "h": 4},
     "datasource": "${ds}", "targets": [{"expr": "min(vcs_server_uptime_seconds)"}]},
    {"id": 9, "type": "timeseries", "title": "Audit appends /s", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 4},
     "datasource": "${ds}", "targets": [{"expr": "rate(vcs_server_audit_appends_total[5m])"}]}
  ]
}
